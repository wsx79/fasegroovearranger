+            odd += isHit (p[Lane::shaker][(size_t) i]) ? 1 : 0;
+        if (odd < 8)
+        {
+            static const char steps[] = "g.xx..x.g.xx..xg";
+            for (int i = 0; i < len; ++i)
+                p[Lane::shaker][(size_t) i] = steps[i % 16];
+        }
+    }
