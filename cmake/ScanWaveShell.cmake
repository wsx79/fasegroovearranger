# JUCE 8.0.9 trusts moduleinfo.json before opening a factory. WaveShell's
# manifest can describe only the wrapper: enumerate its actual factory instead.
get_target_property(fga_juce_modules juce::juce_audio_processors INTERFACE_JUCE_MODULE_PATH)
set(fga_vst3 "${fga_juce_modules}/juce_audio_processors/format_types/juce_VST3PluginFormat.cpp")
file(READ "${fga_vst3}" fga_vst3_text)
set(fga_fast "if (const auto fast = DescriptionLister::findDescriptionsFast (File (fileOrIdentifier)); ! fast.empty())")
set(fga_factory "if (const auto fast = File (fileOrIdentifier).getFileName().startsWithIgnoreCase (\"WaveShell\") ? std::vector<PluginDescription>{} : DescriptionLister::findDescriptionsFast (File (fileOrIdentifier)); ! fast.empty())")
string(FIND "${fga_vst3_text}" "${fga_factory}" fga_patched)
if(fga_patched EQUAL -1)
    string(FIND "${fga_vst3_text}" "${fga_fast}" fga_found)
    if(fga_found EQUAL -1)
        message(FATAL_ERROR "Review the WaveShell scanner adaptation for this JUCE version")
    endif()
    string(REPLACE "${fga_fast}" "${fga_factory}" fga_vst3_text "${fga_vst3_text}")
    file(WRITE "${fga_vst3}" "${fga_vst3_text}")
endif()

# Backport the ordering fix described by JUCE upstream commit 3fa28d0a14f1.
# Use the SAME host object for class lookup and component initialization.
file(READ "${fga_vst3}" fga_vst3_text)
set(fga_context_original "${fga_vst3_text}")
function(fga_replace_scan old new)
    string(FIND "${fga_vst3_text}" "${new}" applied)
    if(applied EQUAL -1)
        string(FIND "${fga_vst3_text}" "${old}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Review JUCE VST3 host-context adaptation")
        endif()
        string(REPLACE "${old}" "${new}" fga_vst3_text "${fga_vst3_text}")
        set(fga_vst3_text "${fga_vst3_text}" PARENT_SCOPE)
    endif()
endfunction()
fga_replace_scan("create (const File& pluginFile, const PluginDescription& desc)" "create (const File& pluginFile, const PluginDescription& desc, VST3HostContext& hostContext)")
fga_replace_scan("        const auto numClasses = factory->countClasses();\n        result.classIndex" "        if (VSTComSmartPtr<IPluginFactory3> pf3; pf3.loadFrom (factory.get()))\n            pf3->setHostContext (hostContext.getFUnknown());\n\n        const auto numClasses = factory->countClasses();\n        result.classIndex")
fga_replace_scan("explicit VST3ComponentHolder (const VST3ModuleHandle& m)\n        : module (m)\n    {\n        host = addVSTComSmartPtrOwner (new VST3HostContext());\n    }" "explicit VST3ComponentHolder (const VST3ModuleHandle& m, VSTComSmartPtr<VST3HostContext> context)\n        : module (m), host (std::move (context))\n    {}")
fga_replace_scan("    const auto module = VST3ModuleHandle::create (file, description);" "    auto host = addVSTComSmartPtrOwner (new VST3HostContext());\n    const auto module = VST3ModuleHandle::create (file, description, *host);")
fga_replace_scan("std::make_unique<VST3ComponentHolder> (module)" "std::make_unique<VST3ComponentHolder> (module, host)")
fga_replace_scan("        for (const auto& d : DescriptionLister::findDescriptionsSlow (*host, *pluginFactory, File (file)))" "        if (VSTComSmartPtr<IPluginFactory3> pf3; pf3.loadFrom (pluginFactory.get()))\n            pf3->setHostContext (host->getFUnknown());\n\n        for (const auto& d : DescriptionLister::findDescriptionsSlow (*host, *pluginFactory, File (file)))")
if(NOT fga_context_original STREQUAL fga_vst3_text)
    file(WRITE "${fga_vst3}" "${fga_vst3_text}")
endif()
