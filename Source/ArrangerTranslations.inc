{ "SNAP: 1/2 beat", "GRIGLIA: 1/2 beat", "REJILLA: 1/2 pulso", "GRILLE : 1/2 temps", "RASTER: 1/2 Schlag", "GRADE: 1/2 tempo" },
{ "SNAP: 1/4 beat", "GRIGLIA: 1/4 beat", "REJILLA: 1/4 pulso", "GRILLE : 1/4 temps", "RASTER: 1/4 Schlag", "GRADE: 1/4 tempo" },
{ "SNAP: OFF", "GRIGLIA: LIBERA", "REJILLA: LIBRE", "GRILLE : LIBRE", "RASTER: FREI", "GRADE: LIVRE" },
